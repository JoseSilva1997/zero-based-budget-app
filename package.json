{
  "name": "house-budget",
  "version": "1.0.3",
  "description": "House Budget. A simple zero-based budget desktop application to manage your expenses and income.",
  "main": "build/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:renderer": "node scripts/build-renderer.mjs",
    "watch:renderer": "node scripts/build-renderer.mjs --watch",
    "icon": "node scripts/make-icon.mjs",
    "rebuild": "node scripts/fix-node-gyp.mjs && electron-rebuild -f -w better-sqlite3",
    "prestart": "npm run build && npm run build:renderer",
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "dev:update": "node scripts/dev.mjs --update-sim=available",
    "dev:update:downloaded": "node scripts/dev.mjs --update-sim=downloaded",
    "dev:update:none": "node scripts/dev.mjs --update-sim=none",
    "dev:update:error": "node scripts/dev.mjs --update-sim=error",
    "pack": "npm run build && npm run build:renderer && node scripts/make-icon.mjs && node scripts/fix-node-gyp.mjs && electron-builder --dir",
    "dist": "npm run build && npm run build:renderer && node scripts/make-icon.mjs && node scripts/fix-node-gyp.mjs && electron-builder",
    "pretest": "npm run build && node scripts/check-inline-styles.mjs && node scripts/check-components.mjs && node scripts/check-platform.mjs",
    "check:styles": "node scripts/check-inline-styles.mjs",
    "check:components": "node scripts/check-components.mjs",
    "check:platform": "node scripts/check-platform.mjs",
    "test:tokens": "electron tests/tokens-electron.cjs",
    "test:tokens:report": "electron tests/tokens-electron.cjs --report",
    "test": "electron tests/smoke-electron.cjs && electron tests/repo-electron.cjs && electron tests/migration-electron.cjs && electron tests/updater-electron.cjs && electron tests/update-banner-electron.cjs && electron tests/sidebar-electron.cjs && electron tests/menu-electron.cjs && electron tests/tokens-electron.cjs && electron tests/bar-electron.cjs && electron tests/debug-screenshot-electron.cjs",
    "check:version": "node scripts/check-version.mjs"
  },
  "build": {
    "appId": "com.housebudget.app",
    "artifactName": "${name}-Setup-${version}.${ext}",
    "productName": "House Budget",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "renderer/dist/**/*",
      "assets/icon.ico",
      "database/schema.sql",
      "database/triggers.sql"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JoseSilva1997",
        "repo": "zero-based-budget-app",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@material-symbols/svg-400": "^0.45.10",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.7.3"
  }
}
