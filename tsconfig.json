{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2020", "DOM"],
    "rootDir": ".",
    "outDir": "build",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node", "better-sqlite3"]
  },
  "include": ["main/**/*.ts", "preload/**/*.ts", "database/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "build", "renderer"]
}
